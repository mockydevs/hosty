# Copy to .env for local development. All settings use the HOSTY_ prefix.
HOSTY_ENV=dev
HOSTY_SECRET_KEY=change-me-to-a-long-random-string
HOSTY_DATABASE_URL=sqlite+aiosqlite:///./hosty.db
# Prod: serve over HTTPS only and set this to true
HOSTY_COOKIE_SECURE=false
# Prod: schema is managed by `alembic upgrade head`
HOSTY_CREATE_TABLES_ON_STARTUP=true

# Phase 7: DNS (PowerDNS API; provision.sh writes the key to /etc/hosty/pdns-api-key)
HOSTY_PDNS_API_URL=http://127.0.0.1:8083/api/v1
HOSTY_PDNS_API_KEY=change-me
# Public IP of this server: enables "point to this server" records/templates
HOSTY_PUBLIC_IP=
# Cloudflare API token (Zone.DNS edit permission): enables one-click push
HOSTY_CLOUDFLARE_API_TOKEN=

# Phase 8: backups (local always on; S3 mirror optional, MinIO-compatible)
HOSTY_BACKUPS_ROOT=/var/lib/hosty/backups
HOSTY_BACKUP_SCHEDULER_ENABLED=true
HOSTY_S3_ENDPOINT=
HOSTY_S3_BUCKET=
HOSTY_S3_ACCESS_KEY=
HOSTY_S3_SECRET_KEY=
